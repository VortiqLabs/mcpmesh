# Set ONEAUTH_RESOURCE_URL to this Codespaces forwarded URL, and allow the exact same URL in OneAuth as ONEAUTH_MCP_RESOURCE_URL.
ONEAUTH_ISSUER_URL=https://oneauth.nishantapps.in
ONEAUTH_INTROSPECTION_URL=https://oneauth.nishantapps.in/api/oauth/introspect
ONEAUTH_RESOURCE_URL=https://your-codespace-8080.app.github.dev/mcp
ONEAUTH_RESOURCE_SERVER_KEY=replace-with-the-same-long-random-secret-configured-in-oneauth

# MCP Mesh listener
HOST=0.0.0.0
PORT=8080
MCP_PATH=/mcp
DEVICE_WS_PATH=/device
AGENT_WS_PATH=/agent
# OAuth client ID used by the VortiqLabs Agent VS Code extension. Agent sockets must authenticate with this client.
ONEAUTH_AGENT_CLIENT_ID=oa_8WSUjKeAT6CaaJLdZ1Lsr-oHu-ow3LHT
# Comma-separated browser origins. Keep empty when only server-side clients connect.
MCP_ALLOWED_ORIGINS=https://github.dev,https://*.app.github.dev
