NODE_ENV=development
HOST=127.0.0.1
PORT=8080
PUBLIC_BASE_URL=https://mcp.nishantapps.in
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mcp_mesh
DATABASE_POOL_MAX=10
ONEAUTH_ISSUER=https://oneauth.nishantapps.in
ONEAUTH_JWKS_URI=https://oneauth.nishantapps.in/.well-known/jwks.json
ONEAUTH_AUDIENCE=mcp-mesh
ONEAUTH_DISCOVERY_URL=https://oneauth.nishantapps.in/.well-known/openid-configuration
AGENT_HEARTBEAT_INTERVAL_MS=15000
AGENT_HEARTBEAT_TIMEOUT_MS=45000
AGENT_REQUEST_TIMEOUT_MS=30000
MAX_AGENT_MESSAGE_BYTES=1048576
ALLOWED_HOSTS=mcp.nishantapps.in
LOG_LEVEL=info
